# Copy to .env — never commit real secrets

# --- App ---
NODE_ENV=development
TZ=UTC

# --- Database (Postgres) ---
DATABASE_URL=postgresql://dodo:dodo@localhost:5432/dodo?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth (API) ---
JWT_ACCESS_SECRET=change_me_access_dev_only_min_32_chars_xx
JWT_REFRESH_SECRET=change_me_refresh_dev_only_min_32_chars_x
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# --- Stripe (test keys only in non-prod) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey_change_me_dev_only

# --- Object storage (MinIO / R2 / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dodo
S3_ACCESS_KEY=dodo
S3_SECRET_KEY=dodo_secret_change
S3_FORCE_PATH_STYLE=true

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# --- Public apps (non-secret only) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# --- API ---
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
