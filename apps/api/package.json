{
  "name": "@dodo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint ok @dodo/api\"",
    "test": "tsx src/health.selftest.ts && tsx src/auth.selftest.ts && tsx src/catalog.selftest.ts",
    "test:session": "tsx src/auth.session.selftest.ts",
    "test:place-order": "tsx src/orders.place-order.selftest.ts",
    "test:g3": "tsx src/orders.g3.selftest.ts",
    "test:invoice-issuance": "tsx src/invoices.issuance.selftest.ts",
    "test:invoice-pdf": "tsx src/invoices.invoice-pdf.selftest.ts",
    "test:invoice-after-sale": "tsx src/invoices.after-sale.selftest.ts",
    "test:company-settings-admin": "tsx src/company-settings.admin.selftest.ts",
    "test:store-identity": "tsx src/store-identity.selftest.ts",
    "test:legal-pages": "tsx src/legal-pages.selftest.ts",
    "test:legal-pages-agb": "tsx src/legal-pages.agb.selftest.ts",
    "test:legal-pages-datenschutz": "tsx src/legal-pages.datenschutz.selftest.ts",
    "test:legal-pages-widerruf": "tsx src/legal-pages.widerruf.selftest.ts",
    "test:legal-pages-faq": "tsx src/legal-pages.faq.selftest.ts",
    "test:contact": "tsx src/contact.selftest.ts",
    "test:notifications": "node dist/notifications.selftest.js",
    "test:payment-intent": "node dist/orders.payment-intent.selftest.js",
    "test:payment-retry": "node dist/orders.payment-retry.selftest.js",
    "test:webhook": "tsx src/payments.webhook.selftest.ts",
    "test:inventory-residual": "node dist/inventory.residual.selftest.js",
    "test:unpaid-expiry": "node dist/orders.unpaid-expiry.selftest.js",
    "test:r22d-clawback": "tsx src/payments.r22d.clawback.selftest.ts",
    "test:r22c-coupon-release": "node dist/orders.r22c.coupon-release.selftest.js",
    "test:r22f-provider-cancel": "node dist/orders.r22f.provider-cancel.selftest.js",
    "test:admin-resend": "node dist/orders.admin-resend.selftest.js",
    "test:order-cancelled": "node dist/orders.order-cancelled.selftest.js",
    "test:post-order-email": "node dist/email.post-order.selftest.js",
    "test:admin-http-idempotency": "tsx src/admin-http-idempotency.selftest.ts",
    "test:admin-refund": "node dist/payments.admin-refund.selftest.js",
    "test:home": "node dist/home.selftest.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@dodo/database": "workspace:*",
    "@dodo/shared-types": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.2",
    "@nestjs/throttler": "^6.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dodo/tsconfig": "workspace:*",
    "@types/argon2": "^0.15.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
