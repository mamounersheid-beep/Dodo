{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/category/[slug]",
      "regex": "^/category/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/category/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/agb",
      "regex": "^/agb(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agb(?:/)?$"
    },
    {
      "page": "/datenschutz",
      "regex": "^/datenschutz(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/datenschutz(?:/)?$"
    },
    {
      "page": "/help",
      "regex": "^/help(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/help(?:/)?$"
    },
    {
      "page": "/help/contact",
      "regex": "^/help/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/help/contact(?:/)?$"
    },
    {
      "page": "/help/faq",
      "regex": "^/help/faq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/help/faq(?:/)?$"
    },
    {
      "page": "/impressum",
      "regex": "^/impressum(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/impressum(?:/)?$"
    },
    {
      "page": "/widerruf",
      "regex": "^/widerruf(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/widerruf(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}